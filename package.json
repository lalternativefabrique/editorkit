{
  "name": "@lalternative/editor",
  "version": "0.15.0",
  "description": "Shared TipTap editor for L'Alternative apps: rich text, format menu, selection toolbar and inline AI revisions",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./revisions": {
      "import": "./dist/revisions.js",
      "types": "./dist/revisions.d.ts"
    },
    "./native": {
      "import": "./dist/native.js",
      "types": "./dist/native.d.ts"
    },
    "./article": {
      "import": "./dist/article.js",
      "types": "./dist/article.d.ts"
    },
    "./article/server": {
      "import": "./dist/article-server.js",
      "types": "./dist/article-server.d.ts"
    },
    "./article.css": "./dist/article.css",
    "./styles.css": "./dist/editor.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "playground": "vite --config playground/vite.config.ts"
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "remark-gfm": "^4.0.1"
  },
  "peerDependencies": {
    "@tiptap/core": ">=3.0.0",
    "@tiptap/pm": ">=3.0.0",
    "@tiptap/react": ">=3.0.0",
    "@tiptap/starter-kit": ">=3.0.0",
    "@tiptap/suggestion": ">=3.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "react-native": ">=0.74.0"
  },
  "devDependencies": {
    "@tiptap/core": "^3.29.2",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "@tiptap/suggestion": "^3.29.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-native": "^0.81.6",
    "tsup": "^8.5.1",
    "typescript": "^5.7.0",
    "vite": "^7.1.7",
    "vitest": "^3.0.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lalternativefabrique/editorkit.git"
  },
  "peerDependenciesMeta": {
    "@tiptap/starter-kit": {
      "optional": true
    },
    "@tiptap/suggestion": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "@tiptap/core": {
      "optional": true
    },
    "@tiptap/pm": {
      "optional": true
    },
    "@tiptap/react": {
      "optional": true
    }
  },
  "license": "MPL-2.0"
}
