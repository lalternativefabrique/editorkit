{
  "name": "@lalternative/editor",
  "version": "0.20.0",
  "description": "Shared editor and article for L'Alternative apps: TipTap writing surface, article rendering and audio player for React, Vue, Svelte and plain JS",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./revisions": {
      "import": "./dist/revisions.js",
      "types": "./dist/revisions.d.ts"
    },
    "./native": {
      "import": "./dist/native.js",
      "types": "./dist/native.d.ts"
    },
    "./article": {
      "import": "./dist/article.js",
      "types": "./dist/article.d.ts"
    },
    "./article/server": {
      "import": "./dist/article-server.js",
      "types": "./dist/article-server.d.ts"
    },
    "./article/element": {
      "import": "./dist/article-element.js",
      "types": "./dist/article-element.d.ts"
    },
    "./article.css": "./dist/article.css",
    "./styles.css": "./dist/editor.css",
    "./vue": {
      "import": "./dist/article-vue.js",
      "types": "./dist/article-vue.d.ts"
    },
    "./svelte": {
      "svelte": "./dist/svelte/Article.svelte",
      "default": "./dist/svelte/Article.svelte"
    },
    "./kertas": {
      "import": "./dist/kertas.js",
      "types": "./dist/kertas.d.ts"
    },
    "./kertas.css": "./dist/kertas.css",
    "./kertas/assets/*": "./dist/kertas/*",
    "./writing.css": "./dist/writing.css"
  },
  "files": [
    "dist",
    "LICENSE-kertas.md"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npx -y pnpm@11.3.0 install --frozen-lockfile && npm run build",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "playground": "vite --config playground/vite.config.ts",
    "playground:article": "vite --config playground/article/vite.config.ts",
    "build:wasm": "./kertas/build-wasm.sh",
    "playground:kertas": "vite --config playground/kertas/vite.config.ts"
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.26",
    "@tiptap/extension-code-block-lowlight": "^3.31.4",
    "@tiptap/extension-document": "^3.31.4",
    "@tiptap/extension-highlight": "^3.31.4",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extension-list": "^3.31.4",
    "@tiptap/extension-mathematics": "^3.31.4",
    "@tiptap/extension-text-align": "^3.31.4",
    "@tiptap/extension-text-style": "^3.31.4",
    "fflate": "0.8.2",
    "katex": "^0.19.1",
    "lit": "^3.3.3",
    "lowlight": "^3.3.0",
    "pdfjs-dist": "4.10.38",
    "remark-gfm": "^4.0.1"
  },
  "peerDependencies": {
    "@tiptap/core": ">=3.0.0",
    "@tiptap/pm": ">=3.0.0",
    "@tiptap/react": ">=3.0.0",
    "@tiptap/starter-kit": ">=3.0.0",
    "@tiptap/suggestion": ">=3.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "react-native": ">=0.74.0",
    "svelte": ">=5.0.0",
    "vue": ">=3.4.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tiptap/core": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@tiptap/suggestion": "^3.31.4",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "dictionary-en": "4.0.0",
    "dictionary-fr": "3.0.0",
    "happy-dom": "^21.0.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-native": "^0.81.6",
    "svelte": "^5.57.3",
    "tsup": "^8.5.1",
    "typescript": "^5.7.0",
    "vite": "^7.1.7",
    "vitest": "^3.0.0",
    "vue": "^3.5.44"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lalternativefabrique/editorkit.git"
  },
  "peerDependenciesMeta": {
    "@tiptap/starter-kit": {
      "optional": true
    },
    "@tiptap/suggestion": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "@tiptap/core": {
      "optional": true
    },
    "@tiptap/pm": {
      "optional": true
    },
    "@tiptap/react": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "svelte": {
      "optional": true
    }
  },
  "license": "(MPL-2.0 AND PolyForm-Noncommercial-1.0.0)"
}
